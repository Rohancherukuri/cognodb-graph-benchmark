# ---- CognoDB Cloud (see README "Set up CognoDB Cloud") ----
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# ---- Neo4j AuraDB Free (https://console.neo4j.io) ----
NEO4J_AURA_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_AURA_USER=neo4j
NEO4J_AURA_PASSWORD=

# ---- Memgraph (self-hosted via docker-compose, resource-capped) ----
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# ---- ArangoDB (self-hosted via docker-compose, resource-capped) ----
ARANGODB_URL=http://localhost:8529
ARANGODB_USER=root
ARANGODB_PASSWORD=
ARANGODB_DB=_system

# ---- Dgraph (self-hosted via docker-compose, resource-capped) ----
DGRAPH_ALPHA_ADDR=localhost:9080

# ---- Benchmark tuning ----
BENCHMARK_ITERATIONS=100
BENCHMARK_CONCURRENCY_LEVELS=1,10,40
BENCHMARK_MIXED_DURATION_SEC=30
DATASET_TARGET_EDGES=300000
RANDOM_SEED=42
